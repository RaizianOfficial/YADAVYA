rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an authenticated admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email in ['admin@yadavya.com', 'sunny@example.com'] || 
         request.auth.token.admin == true);
    }

    // Products: public can read published products, admin has full access
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Categories: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings: public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: anyone can create an order (checkout), only admin can view or modify
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
